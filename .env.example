# ---------- Site web / API (apps/web/.env) ----------
# Base PostgreSQL (locale via docker-compose, ou Neon en production)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/retrouve"

# Secret de signature des sessions (au moins 32 caractères).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-moi-avec-une-longue-chaine-aleatoire-de-48-caracteres"

# URL publique du site (utilisée dans les liens des SMS et des PDF)
APP_URL="http://localhost:3000"

# Secret pour protéger les tâches planifiées /api/cron/* (Vercel l'envoie dans Authorization)
CRON_SECRET="change-moi-aussi"

# Optionnel : jeton d'accès Expo pour l'envoi des notifications push (sécurité renforcée)
EXPO_ACCESS_TOKEN=""

# ---------- App mobile (apps/mobile/.env) ----------
# Adresse du serveur vue depuis le téléphone (pas "localhost" : utiliser l'IP du PC ou l'URL Vercel)
EXPO_PUBLIC_API_URL="http://192.168.1.10:3000"
