# ---------- Site web / API (apps/web/.env) ----------
# Base PostgreSQL (locale via docker-compose, ou Neon en production)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/retrouve"
# Connexion directe utilisée par les migrations (avec Neon : remplie automatiquement par l'intégration Vercel)
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@127.0.0.1:5432/retrouve"

# Secret de signature des sessions (au moins 32 caractères).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-moi-avec-une-longue-chaine-aleatoire-de-48-caracteres"

# URL publique du site (utilisée dans les liens des SMS et des PDF)
APP_URL="http://localhost:3000"

# Secret pour protéger les tâches planifiées /api/cron/* (Vercel l'envoie dans Authorization)
CRON_SECRET="change-moi-aussi"

# Optionnel : jeton d'accès Expo pour l'envoi des notifications push (sécurité renforcée)
EXPO_ACCESS_TOKEN=""

# Emails (mot de passe oublié, alertes) via Gmail.
# Créez un « mot de passe d'application » : https://myaccount.google.com/apppasswords
# (la validation en deux étapes doit être activée sur le compte Google).
# Sans ces variables, les emails s'affichent seulement dans la console du serveur.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="votre.adresse@gmail.com"
SMTP_PASSWORD=""
MAIL_FROM="Retrouve <votre.adresse@gmail.com>"
# Adresse de contact affichée dans les pages légales (par défaut : SMTP_USER)
CONTACT_EMAIL=""

# Notifications du navigateur (web push). Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:votre.adresse@gmail.com"

# ---------- App mobile (apps/mobile/.env) ----------
# Adresse du serveur vue depuis le téléphone (pas "localhost" : utiliser l'IP du PC ou l'URL Vercel)
EXPO_PUBLIC_API_URL="http://192.168.1.10:3000"
